# Copia este archivo como ".env" (ignorado por git) solo si necesitas cambiar
# los valores por defecto. NO guardes aqui credenciales reales.

# Conexion del microservicio a MongoDB (la lee application.properties).
# Si tu Mongo exige usuario y clave, incluyelos aqui y nunca en el repositorio:
# MONGODB_URI=mongodb://usuario:clave@localhost:27017/estudiantes?authSource=admin
MONGODB_URI=mongodb://localhost:27017/estudiantes

# Puertos publicados por compose.yaml
MONGO_PORT=27017
